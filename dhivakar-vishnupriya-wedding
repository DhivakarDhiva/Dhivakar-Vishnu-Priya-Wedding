<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dhivakar & Vishnu Priya — Wedding Invitation</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600;700&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#c9a84c; --gold-l:#e8c96a; --gold-d:rgba(201,168,76,0.16);
  --ivory:#fffdf5; --deep:#0d0b08; --card:#151210;
  --tm:#f5edd8; --ts:rgba(245,237,216,0.58); --tmu:rgba(245,237,216,0.32);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--deep);color:var(--tm);font-family:'Cormorant Garamond',serif;overflow-x:hidden;min-height:100vh}
 
/* canvas petals */
#cvs{position:fixed;inset:0;pointer-events:none;z-index:0}
 
.pg{position:relative;z-index:1}
 
/* ──────────────────────────────
   HERO
────────────────────────────── */
.hero{
  min-height:100vh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:70px 20px 110px;position:relative;
  background:radial-gradient(ellipse 80% 60% at 50% 42%,rgba(201,168,76,0.09) 0%,transparent 65%);
}
 
/* corner filigree */
.crn{position:absolute;width:110px;height:110px;opacity:.25;pointer-events:none}
.crn svg{width:100%;height:100%}
.tl{top:18px;left:18px} .tr{top:18px;right:18px;transform:scaleX(-1)}
.bl{bottom:18px;left:18px;transform:scaleY(-1)} .br{bottom:18px;right:18px;transform:scale(-1,-1)}
 
/* together */
.together{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:clamp(1rem,2.2vw,1.2rem);color:var(--ts);
  letter-spacing:.1em;margin-bottom:14px;
  opacity:0;animation:fup .9s ease .15s forwards
}
 
/* names */
.names-block{opacity:0;animation:fup 1s ease .4s forwards}
.n1{font-family:'Great Vibes',cursive;font-size:clamp(4.5rem,14vw,9.5rem);color:var(--ivory);line-height:1.05;display:block}
.amp{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(1.8rem,5vw,3.2rem);color:var(--gold);display:block;line-height:1.3;margin:4px 0}
.n2{font-family:'Great Vibes',cursive;font-size:clamp(3.5rem,11vw,8rem);color:var(--ivory);line-height:1.05;display:block}
 
/* invite copy */
.invite{
  font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:clamp(1.05rem,2.4vw,1.3rem);color:var(--ts);line-height:1.75;
  max-width:460px;margin:22px auto 0;
  opacity:0;animation:fup .9s ease .8s forwards
}
 
/* gold rule */
.rule{
  display:flex;align-items:center;gap:14px;max-width:300px;margin:32px auto 28px;
  opacity:0;animation:fup .8s ease 1s forwards
}
.rule-line{flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.rule-gem{font-size:1rem;color:var(--gold)}
 
/* ── BIG CTA BUTTONS ── */
.cta-group{
  display:flex;flex-direction:column;align-items:center;gap:14px;
  opacity:0;animation:fup .9s ease 1.2s forwards
}
 
.btn-loc{
  display:inline-flex;align-items:center;gap:11px;
  padding:16px 40px;
  background:linear-gradient(135deg,var(--gold) 0%,#b8912e 100%);
  color:var(--deep);text-decoration:none;
  font-family:'Cinzel',serif;font-size:.74rem;font-weight:700;
  letter-spacing:.28em;text-transform:uppercase;
  box-shadow:0 6px 28px rgba(201,168,76,.35);
  transition:transform .25s,box-shadow .25s
}
.btn-loc:hover{transform:translateY(-3px);box-shadow:0 10px 36px rgba(201,168,76,.45)}
.btn-loc svg{width:17px;height:17px;flex-shrink:0}
 
.btn-sched{
  display:inline-flex;align-items:center;gap:9px;
  padding:11px 30px;border:1px solid rgba(201,168,76,.4);
  color:var(--gold-l);text-decoration:none;
  font-family:'Cinzel',serif;font-size:.62rem;
  letter-spacing:.3em;text-transform:uppercase;
  transition:border-color .25s,color .25s
}
.btn-sched:hover{border-color:var(--gold);color:var(--gold)}
 
/* scroll cue */
.scue{
  position:absolute;bottom:26px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:6px;
  opacity:0;animation:fin 1s ease 2.3s forwards;
  color:var(--tmu);font-family:'Cinzel',serif;font-size:.5rem;
  letter-spacing:.42em;text-transform:uppercase
}
.sarr{width:1px;height:32px;background:linear-gradient(to bottom,var(--gold),transparent);animation:ab 1.8s ease-in-out infinite}
 
/* ──────────────────────────────
   SCHEDULE SECTION
────────────────────────────── */
.sched-sec{padding:80px 20px 60px;max-width:680px;margin:0 auto;text-align:center}
 
.eyebrow{font-family:'Cinzel',serif;font-size:.6rem;letter-spacing:.48em;text-transform:uppercase;color:var(--gold);margin-bottom:10px}
.sec-h{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,5vw,3rem);font-weight:300;color:var(--ivory);margin-bottom:12px}
.sec-p{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.05rem;color:var(--ts);line-height:1.75;margin-bottom:50px}
 
/* timeline */
.tl-wrap{display:flex;flex-direction:column}
.tl-row{display:grid;grid-template-columns:108px 1px 1fr;gap:0 20px;min-height:96px}
.tl-left{text-align:right;padding-top:2px}
.tl-date{display:block;font-family:'Cinzel',serif;font-size:.7rem;color:var(--gold);letter-spacing:.06em}
.tl-time{display:block;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.88rem;color:var(--ts);margin-top:2px}
.tl-spine{display:flex;flex-direction:column;align-items:center}
.tl-dot{width:13px;height:13px;border-radius:50%;border:2px solid var(--gold);background:var(--deep);flex-shrink:0;z-index:1;position:relative}
.tl-dot.on{background:var(--gold)}
.tl-dot.on::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:1px solid rgba(201,168,76,.28)}
.tl-seg{width:1px;flex:1;background:linear-gradient(to bottom,rgba(201,168,76,.4),rgba(201,168,76,.04));min-height:44px}
.tl-body{padding-bottom:32px;text-align:left}
.tl-ename{font-family:'Cormorant Garamond',serif;font-size:1.28rem;color:var(--ivory);line-height:1.3;margin-bottom:5px}
.tl-edesc{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.93rem;color:var(--ts);line-height:1.6}
.tl-edesc strong{color:var(--tm);font-weight:400}
 
/* notice strip */
.notice{
  margin:44px auto 0;max-width:660px;
  background:rgba(201,168,76,.07);border:1px solid rgba(201,168,76,.24);
  padding:15px 20px;display:flex;align-items:flex-start;gap:12px;border-radius:2px
}
.notice svg{flex-shrink:0;color:var(--gold);margin-top:3px}
.notice p{font-family:'Cormorant Garamond',serif;font-size:1rem;color:var(--tm);line-height:1.65}
.notice strong{color:var(--gold-l);font-weight:400}
 
/* ──────────────────────────────
   VENUES SECTION
────────────────────────────── */
.venues-sec{padding:70px 20px 100px;max-width:1040px;margin:0 auto;scroll-margin-top:24px}
.venues-hdr{text-align:center;margin-bottom:48px}
 
/* grid: 2 cols, 3rd card spans full */
.vgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:28px}
 
/* card */
.vc{background:var(--card);border:1px solid rgba(201,168,76,.18);position:relative;overflow:hidden;transition:border-color .3s,transform .3s}
.vc:hover{border-color:rgba(201,168,76,.48);transform:translateY(-4px)}
.vc-bar{height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.vc-badge{
  position:absolute;top:16px;right:16px;
  font-family:'Cinzel',serif;font-size:.58rem;color:var(--gold);
  letter-spacing:.08em;border:1px solid var(--gold-d);border-radius:100px;padding:3px 11px
}
.vc-in{padding:28px 28px 32px}
 
.vc-tag{
  display:inline-flex;align-items:center;gap:7px;
  font-family:'Cinzel',serif;font-size:.56rem;letter-spacing:.42em;text-transform:uppercase;
  color:var(--gold);margin-bottom:18px;padding:4px 14px;border:1px solid var(--gold-d);border-radius:100px
}
.tdot{width:5px;height:5px;border-radius:50%;background:var(--gold);opacity:.6}
 
.vic{width:50px;height:50px;border-radius:50%;background:rgba(201,168,76,.08);display:flex;align-items:center;justify-content:center;color:var(--gold);margin-bottom:15px}
.vic svg{width:24px;height:24px}
 
.vc-title{font-family:'Cormorant Garamond',serif;font-size:clamp(1.4rem,3.5vw,1.9rem);font-weight:300;color:var(--ivory);line-height:1.25;margin-bottom:4px}
.vc-sub{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.96rem;color:var(--gold-l);margin-bottom:20px}
.vc-rule{height:1px;background:linear-gradient(90deg,var(--gold-d),transparent);margin-bottom:18px}
 
.ir{display:flex;align-items:flex-start;gap:11px;margin-bottom:12px}
.ir-ic{flex-shrink:0;width:27px;height:27px;border-radius:50%;background:rgba(201,168,76,.08);display:flex;align-items:center;justify-content:center;color:var(--gold);margin-top:2px}
.ir-ic svg{width:12px;height:12px}
.ir-t{font-family:'Cormorant Garamond',serif;font-size:.96rem;color:var(--tm);line-height:1.6}
.ir-lbl{display:block;font-family:'Cinzel',serif;font-size:.5rem;letter-spacing:.4em;text-transform:uppercase;color:var(--tmu);margin-bottom:2px}
 
/* map button — BIG & CLEAR */
.mbutton{
  display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;margin-top:24px;padding:15px 20px;
  background:linear-gradient(135deg,rgba(201,168,76,.14) 0%,rgba(201,168,76,.05) 100%);
  border:1px solid rgba(201,168,76,.44);
  color:var(--gold-l);text-decoration:none;
  font-family:'Cinzel',serif;font-size:.65rem;letter-spacing:.28em;text-transform:uppercase;
  position:relative;overflow:hidden;transition:color .3s,border-color .3s
}
.mbutton::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,var(--gold),#b8912e);
  transform:translateY(101%);transition:transform .35s cubic-bezier(.4,0,.2,1)
}
.mbutton:hover::before{transform:translateY(0)}
.mbutton:hover{color:var(--deep);border-color:var(--gold)}
.mbutton>*{position:relative;z-index:1}
.mhint{text-align:center;margin-top:7px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.78rem;color:var(--tmu)}
 
/* span full row for card 3 */
.span-full{grid-column:1/-1;max-width:580px;margin:0 auto;width:100%}
 
/* ──────────────────────────────
   FOOTER
────────────────────────────── */
.footer{text-align:center;padding:50px 20px 40px;border-top:1px solid rgba(201,168,76,.1)}
.f-heart{font-size:1.5rem;color:var(--gold);animation:hb 2.2s ease-in-out infinite}
.f-script{font-family:'Great Vibes',cursive;font-size:clamp(2rem,6vw,3.2rem);color:var(--gold-l);margin:8px 0}
.f-msg{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1rem;color:var(--ts);line-height:1.8;max-width:360px;margin:0 auto}
.f-copy{margin-top:26px;font-family:'Cinzel',serif;font-size:.5rem;letter-spacing:.4em;color:var(--tmu);text-transform:uppercase}
 
/* reveal */
.rv{opacity:0;transform:translateY(22px);transition:opacity .75s ease,transform .75s ease}
.rv.in{opacity:1;transform:none}
/* when jumping via anchor, instantly show venues section children */
.venues-sec .rv{transition-delay:0s!important}
 
/* keyframes */
@keyframes fup{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@keyframes fin{from{opacity:0}to{opacity:1}}
@keyframes ab{0%,100%{transform:scaleY(1);opacity:.4}50%{transform:scaleY(1.28);opacity:1}}
@keyframes hb{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}
 
